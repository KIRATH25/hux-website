{
  "name": "hux-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/apk.mjs copy",
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "assets": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/apk.mjs remove && node scripts/prepare-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-export.mjs && node scripts/check-out.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "shots": "node scripts/shots.mjs",
    "serve": "node scripts/serve-out.mjs 3100",
    "capture": "node scripts/capture-app.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsqr": "^1.4.0",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
